@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <h1>TodoApp</h1>
</head>
<body>
    <!-- Todo List -->
    <ul>
        <li>Task 1</li>
        <li>Task 2</li>
        <li>Task 3</li>
    </ul>

    <!--必要な機能はタスクを登録する-->
    <form>
        <input type="text" placeholder="Enter a new task" />
        <button type="submit">Add Task</button>
    </form>

    <!--登録したタスクを表示する-->
    <ul>
        <li>Task 1</li>
        <li>Task 2</li>
        <li>Task 3</li>
    </ul>

    <!--登録したタスクを削除する-->
    <form>
        <input type="text" placeholder="Enter the task to delete" />
        <button type="submit">Delete Task</button>
    </form>

</body>
</html>